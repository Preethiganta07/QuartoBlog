const KPICard = ({ title, value, change, icon, color, subtitle }) => {
  const isPositive = change >= 0;
  return (
    <div style={{
      background: "linear-gradient(135deg, #1a1f35 0%, #0d1224 100%)",
      border: `1px solid ${color}22`,
      borderRadius: "16px",
      padding: "24px",
      position: "relative",
      overflow: "hidden",
      boxShadow: `0 4px 24px ${color}15`,
      transition: "transform 0.2s, box-shadow 0.2s",
      cursor: "default",
    }}
      onMouseEnter={e => { e.currentTarget.style.transform = "translateY(-4px)"; e.currentTarget.style.boxShadow = `0 12px 32px ${color}30`; }}
      onMouseLeave={e => { e.currentTarget.style.transform = "translateY(0)"; e.currentTarget.style.boxShadow = `0 4px 24px ${color}15`; }}
    >
      <div style={{ position: "absolute", top: 0, right: 0, width: "80px", height: "80px", background: `radial-gradient(circle, ${color}20 0%, transparent 70%)`, borderRadius: "0 16px 0 80px" }} />
      <div style={{ fontSize: "28px", marginBottom: "8px" }}>{icon}</div>
      <div style={{ color: "#8892b0", fontSize: "12px", fontFamily: "'DM Mono', monospace", letterSpacing: "2px", textTransform: "uppercase", marginBottom: "8px" }}>{title}</div>
      <div style={{ color: "#e6f1ff", fontSize: "32px", fontWeight: "700", fontFamily: "'Syne', sans-serif", lineHeight: 1 }}>{value}</div>
      <div style={{ marginTop: "10px", display: "flex", alignItems: "center", gap: "6px" }}>
        <span style={{ color: isPositive ? "#00D4AA" : "#FF6B6B", fontSize: "13px", fontWeight: "600" }}>
          {isPositive ? "▲" : "▼"} {Math.abs(change)}%
        </span>
        <span style={{ color: "#8892b0", fontSize: "12px" }}>{subtitle}</span>
      </div>
    </div>
  );
};

const CustomTooltip = ({ active, payload, label }) => {
  if (active && payload && payload.length) {
    return (
      <div style={{ background: "#1a1f35", border: "1px solid #2d3748", borderRadius: "10px", padding: "12px 16px" }}>
        <p style={{ color: "#8892b0", fontSize: "12px", marginBottom: "6px" }}>{label}</p>
        {payload.map((p, i) => (
          <p key={i} style={{ color: p.color, fontSize: "14px", fontWeight: "600" }}>
            {p.name}: {typeof p.value === "number" && p.value > 1000 ? `$${p.value.toLocaleString()}` : p.value.toLocaleString()}
          </p>
        ))}
      </div>
    );
  }
  return null;
};

